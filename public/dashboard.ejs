<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kimbweta Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg: #f4f7fb;
            --surface: #ffffff;
            --surface-2: #eef4fb;
            --text: #172033;
            --muted: #64748b;
            --border: #d9e1ec;
            --primary: #1d4ed8;
            --primary-dark: #1e40af;
            --success: #0f766e;
            --danger: #dc2626;
            --sidebar: #14243a;
        }

        .dark {
            --bg: #0f1419;
            --surface: #1a202c;
            --surface-2: #2d3748;
            --text: #f8fafc;
            --muted: #cbd5e1;
            --border: #4a5568;
            --sidebar: #0b1220;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
            background: var(--bg);
            color: var(--text);
            transition: background-color 0.3s, color 0.3s;
        }

        button, input, textarea {
            font: inherit;
        }

        .layout {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 260px 1fr;
        }

        .sidebar {
            background: var(--sidebar);
            color: white;
            padding: 24px 20px;
            display: flex;
            flex-direction: column;
            gap: 32px;
            box-shadow: 2px 0 8px rgba(0, 0, 0, 0.1);
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 0.02em;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav {
            display: grid;
            gap: 8px;
            list-style: none;
        }

        .nav button {
            width: 100%;
            border: 0;
            background: transparent;
            color: #dbe7f5;
            padding: 12px 14px;
            border-radius: 8px;
            cursor: pointer;
            text-align: left;
            font-weight: 600;
            transition: all 0.2s;
        }

        .nav button:hover {
            background: rgba(255, 255, 255, 0.15);
            color: white;
            transform: translateX(4px);
        }

        .nav button.active {
            background: var(--primary);
            color: white;
        }

        .main {
            padding: 30px;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }

        .topbar-left h1 {
            font-size: clamp(28px, 4vw, 40px);
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 4px;
        }

        .topbar-left p {
            color: var(--muted);
            font-size: 14px;
            font-weight: 500;
        }

        .topbar-right {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .profile-section {
            position: relative;
        }

        .profile-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text);
            padding: 8px 16px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s;
            font-weight: 600;
            font-size: 14px;
        }

        .profile-btn:hover {
            background: var(--surface-2);
            border-color: var(--primary);
            box-shadow: 0 4px 12px rgba(29, 78, 216, 0.1);
        }

        .profile-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 800;
            font-size: 16px;
        }

        .profile-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            margin-top: 8px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
            min-width: 280px;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.2s;
            z-index: 100;
        }

        .profile-dropdown.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-header {
            padding: 16px;
            border-bottom: 1px solid var(--border);
        }

        .profile-user-info {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .profile-avatar-lg {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 800;
            font-size: 18px;
        }

        .profile-user-text h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
        }

        .profile-user-text p {
            font-size: 13px;
            color: var(--muted);
            margin-top: 2px;
        }

        .profile-actions {
            padding: 8px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .profile-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-radius: 8px;
            cursor: pointer;
            color: var(--text);
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
        }

        .profile-item:hover {
            background: var(--surface-2);
            color: var(--primary);
        }

        .profile-item i {
            width: 18px;
            text-align: center;
        }

        .profile-item.danger:hover {
            background: rgba(220, 38, 38, 0.1);
            color: var(--danger);
        }

        .hamburger {
            display: none;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text);
            border-radius: 8px;
            width: 44px;
            height: 44px;
            cursor: pointer;
            font-size: 18px;
            transition: all 0.2s;
        }

        .hamburger:hover {
            background: var(--surface-2);
        }

        .section {
            display: none;
            animation: fadeIn 0.3s ease-in;
        }

        .section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
            gap: 20px;
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 28px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            transition: all 0.3s;
        }

        .card:hover {
            border-color: var(--primary);
            box-shadow: 0 8px 24px rgba(29, 78, 216, 0.08);
        }

        .card h2 {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .card p {
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .field {
            display: grid;
            gap: 8px;
            margin-bottom: 16px;
        }

        .field label {
            font-size: 13px;
            color: var(--muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .field input,
        .field textarea {
            width: 100%;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text);
            border-radius: 8px;
            padding: 12px;
            outline: none;
            font-size: 14px;
            transition: all 0.2s;
        }

        .field input::placeholder,
        .field textarea::placeholder {
            color: var(--muted);
        }

        .field textarea {
            min-height: 90px;
            resize: vertical;
        }

        .field input:focus,
        .field textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.1);
        }

        .room-code-row {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 12px;
            align-items: flex-end;
        }

        .btn {
            border: 0;
            border-radius: 8px;
            padding: 12px 20px;
            cursor: pointer;
            font-weight: 600;
            color: white;
            background: var(--primary);
            transition: all 0.2s;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(29, 78, 216, 0.3);
        }

        .btn.secondary {
            color: var(--text);
            background: var(--surface);
            border: 1px solid var(--border);
        }

        .btn.secondary:hover {
            background: var(--surface-2);
            border-color: var(--primary);
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            transition: all 0.2s;
        }

        .stat:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .stat strong {
            display: block;
            font-size: 32px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 8px;
        }

        .stat span {
            color: var(--muted);
            font-size: 14px;
        }

        .status {
            margin-bottom: 20px;
            padding: 12px 16px;
            border-radius: 8px;
            background: rgba(15, 118, 110, 0.1);
            color: var(--success);
            font-weight: 600;
            font-size: 14px;
        }

        .status.error {
            background: rgba(220, 38, 38, 0.1);
            color: var(--danger);
        }

        @media (max-width: 780px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: fixed;
                inset: 0 auto 0 0;
                width: 260px;
                z-index: 20;
                transform: translateX(-100%);
                transition: transform 0.3s;
                border-radius: 0 12px 12px 0;
            }

            .sidebar.open {
                transform: translateX(0);
                box-shadow: 2px 0 16px rgba(0, 0, 0, 0.2);
            }

            .hamburger {
                display: inline-flex;
            }

            .main {
                padding: 20px;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
            }

            .topbar-right {
                width: 100%;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .profile-dropdown {
                right: auto;
                left: 0;
            }
        }

        @media (max-width: 480px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .profile-btn span {
                display: none;
            }

            .profile-avatar {
                width: 40px;
                height: 40px;
                font-size: 18px;
            }

            .room-code-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
<div class="layout">
    <aside class="sidebar" id="sidebar">
        <div class="logo">
            <i class="fas fa-video"></i> Online Discussion
        </div>
        <ul class="nav">
            <li><button class="active" type="button" data-section="meetings"><i class="fas fa-phone"></i> Meetings</button></li>
            <li><button type="button" data-section="groups"><i class="fas fa-users"></i> Groups</button></li>
        </ul>
    </aside>

    <main class="main">
        <div class="topbar">
            <div class="topbar-left">
                <h1>Welcome back </h1><h2><%= username %></h2>
                <p>Start a call or organize a group discussion</p>
            </div>
            <div class="topbar-right">
                <button class="hamburger" type="button" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
                <div class="profile-section">
                    <button class="profile-btn" onclick="toggleProfileMenu()">
                        <div class="profile-avatar" id="profileInitial">U</div>
                        <span id="userName">User</span>
                        <i class="fas fa-chevron-down"></i>
                    </button>
                    <div class="profile-dropdown" id="profileDropdown">
                        <div class="profile-header">
                            <div class="profile-user-info">
                                <div class="profile-avatar-lg" id="profileInitialLg">U</div>
                                <div class="profile-user-text">
                                    <h3 id="profileName">User Name</h3>
                                    <p id="profileEmail">user@example.com</p>
                                </div>
                            </div>
                        </div>
                        <div class="profile-actions">
                            <button class="profile-item" onclick="toggleTheme()">
                                <i class="fas fa-moon"></i>
                                <span id="themeLabel">Dark Mode</span>
                            </button>
                            <button class="profile-item" onclick="signOut()" style="color: var(--danger);">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Sign Out</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat">
                <strong id="statRooms">0</strong>
                <span>Quick Rooms</span>
            </div>
            <div class="stat">
                <strong id="statGroups">0</strong>
                <span>Active Groups</span>
            </div>
            <div class="stat">
                <strong id="statMembers">0</strong>
                <span>Total Members</span>
            </div>
        </div>

        <section class="section active" id="meetings">
            <div class="grid">
                <article class="card">
                    <h2><i class="fas fa-video" style="margin-right: 8px; color: var(--primary);"></i>Create Quick Room</h2>
                    <p>Generate a meeting code and enter the video call immediately. No setup required.</p>
                    <button class="btn" type="button" onclick="createQuickRoom()">
                        <i class="fas fa-plus"></i> Create room
                    </button>
                </article>

                <article class="card">
                    <h2><i class="fas fa-door-open" style="margin-right: 8px; color: var(--primary);"></i>Join Room</h2>
                    <p>Enter the room code someone shared with you to join an ongoing discussion.</p>
                    <div class="room-code-row">
                        <div class="field" style="margin-bottom:0;">
                            <label for="roomCodeInput">Room code</label>
                            <input type="text" id="roomCodeInput" placeholder="e.g., 12345" inputmode="numeric" maxlength="6" autocomplete="off">
                        </div>
                        <button class="btn" type="button" onclick="joinQuickRoom()">
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </article>
            </div>
        </section>

        <section class="section" id="groups">
            <p class="status" id="groupStatus"></p>
            <div class="grid">
                <article class="card">
                    <h2><i class="fas fa-plus-circle" style="margin-right: 8px; color: var(--success);"></i>Create Group</h2>
                    <p>Save a group and share its code with members for easy access.</p>
                    <form action="/createGroup" method="post">
                        <div class="field">
                            <label for="groupName">Group name</label>
                            <input id="groupName" type="text" name="name" placeholder="e.g., Project Team" required>
                        </div>
                        <div class="field">
                            <label for="groupDescription">Description (optional)</label>
                            <textarea id="groupDescription" name="description" placeholder="Describe the purpose of this group..."></textarea>
                        </div>
                        <button class="btn" type="submit">
                            <i class="fas fa-save"></i> Create group
                        </button>
                    </form>
                </article>

                <article class="card">
                    <h2><i class="fas fa-user-plus" style="margin-right: 8px; color: var(--primary);"></i>Join Group</h2>
                    <p>Use a saved group code to join an existing discussion space with your team.</p>
                    <form action="/joinGroup" method="post">
                        <div class="field">
                            <label for="groupCode">Group code</label>
                            <input id="groupCode" type="text" name="group_code" placeholder="e.g., ABC123" required>
                        </div>
                        <button class="btn" type="submit">
                            <i class="fas fa-sign-in-alt"></i> Join group
                        </button>
                    </form>
                </article>
            </div>
        </section>
    </main>
</div>

<script>
    const sidebar = document.getElementById('sidebar');
    const navButtons = document.querySelectorAll('.nav button');
    const sections = document.querySelectorAll('.section');
    const roomCodeInput = document.getElementById('roomCodeInput');
    const groupStatus = document.getElementById('groupStatus');
    const profileDropdown = document.getElementById('profileDropdown');

    // Load user data from localStorage or API
    function loadUserData() {
        const userData = localStorage.getItem('userData');
        if (userData) {
            const user = JSON.parse(userData);
            updateUserProfile(user);
        } else {
            // Try to fetch from API
            fetchUserData();
        }
    }

    // Fetch user data from backend
    async function fetchUserData() {
        try {
            const response = await fetch('/api/user', {
                credentials: 'include'
            });
            if (response.ok) {
                const user = await response.json();
                localStorage.setItem('userData', JSON.stringify(user));
                updateUserProfile(user);
            }
        } catch (error) {
            console.log('Could not fetch user data:', error);
            // Use demo data
            updateUserProfile({
                name: 'Demo User',
                email: 'demo@kimbweta.com',
                initials: 'DU'
            });
        }
    }

    // Update profile UI with user data
    function updateUserProfile(user) {
        const initials = user.initials || (user.name || 'User').split(' ').map(n => n[0]).join('').toUpperCase();
        document.getElementById('profileInitial').textContent = initials;
        document.getElementById('profileInitialLg').textContent = initials;
        document.getElementById('profileName').textContent = user.name || 'User';
        document.getElementById('userName').textContent = user.name || 'User';
        document.getElementById('profileEmail').textContent = user.email || 'user@example.com';
    }

    // Theme toggle
    function toggleTheme() {
        const isDark = document.body.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateThemeLabel();
        closeProfileMenu();
    }

    function updateThemeLabel() {
        const isDark = document.body.classList.contains('dark');
        document.getElementById('themeLabel').textContent = isDark ? 'Light Mode' : 'Dark Mode';
    }

    // Load theme preference
    function loadTheme() {
        const theme = localStorage.getItem('theme') || 'light';
        if (theme === 'dark') {
            document.body.classList.add('dark');
        }
        updateThemeLabel();
    }

    // Profile menu
    function toggleProfileMenu() {
        profileDropdown.classList.toggle('active');
    }

    function closeProfileMenu() {
        profileDropdown.classList.remove('active');
    }

    // Sign out
    function signOut() {
        localStorage.removeItem('userData');
        window.location.href = '/login';
    }

    // Sidebar toggle
    function toggleSidebar() {
        sidebar.classList.toggle('open');
    }

    // Section navigation
    function showSection(id) {
        sections.forEach(section => section.classList.toggle('active', section.id === id));
        navButtons.forEach(button => button.classList.toggle('active', button.dataset.section === id));
        sidebar.classList.remove('open');
    }

    // Room code generation
    function generateRoomCode() {
        return Math.floor(10000 + Math.random() * 90000);
    }

    function goToRoom(roomCode) {
        window.location.href = '/room.html?room=' + encodeURIComponent(roomCode);
    }

    function createQuickRoom() {
        goToRoom(generateRoomCode());
    }

    function joinQuickRoom() {
        const roomCode = roomCodeInput.value.trim().replace(/[^0-9]/g, '');

        if (!roomCode) {
            alert('Please enter a room code');
            roomCodeInput.focus();
            return;
        }

        goToRoom(roomCode);
    }

    // Event listeners
    navButtons.forEach(button => {
        button.addEventListener('click', () => showSection(button.dataset.section));
    });

    roomCodeInput.addEventListener('input', function () {
        this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
    });

    roomCodeInput.addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            joinQuickRoom();
        }
    });

    // Close profile menu when clicking outside
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.profile-section')) {
            closeProfileMenu();
        }
    });

    // Check for group status in URL
    const query = new URLSearchParams(window.location.search);
    const groupState = query.get('group');

    if (groupState) {
        showSection('groups');
    }

    if (groupState === 'created') {
        groupStatus.textContent = '✓ Group created successfully. Share code: ' + query.get('code');
    }

    if (groupState === 'joined') {
        groupStatus.textContent = '✓ Joined group successfully. Group code: ' + query.get('code');
    }

    if (groupState === 'missing-name') {
        groupStatus.classList.add('error');
        groupStatus.textContent = '✗ Please enter a group name.';
    }

    if (groupState === 'missing-code') {
        groupStatus.classList.add('error');
        groupStatus.textContent = '✗ Please enter a group code.';
    }

    if (groupState === 'not-found') {
        groupStatus.classList.add('error');
        groupStatus.textContent = '✗ Group code was not found.';
    }

    // Initialize
    loadTheme();
    loadUserData();
</script>
</body>
</html>
